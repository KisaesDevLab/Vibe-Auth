{
  "name": "vibe-auth-ref-app",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Express product using @kisaes/vibe-auth — the Phase 2–7 reference integration",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build ui --outDir ../dist/ui --emptyOutDir",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "vibeAuth": { "adapter": "./dist/vibe-auth-adapter.js" },
  "dependencies": {
    "@kisaes/vibe-auth": "workspace:*",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
